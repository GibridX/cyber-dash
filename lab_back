--
-- TOC entry 248 (class 1259 OID 17080)
-- Name: v_daily_user_stats; Type: VIEW; Schema: public; Owner: lab1
--

CREATE VIEW public.v_daily_user_stats AS
 SELECT user_id,
    ((ended_at AT TIME ZONE 'UTC'::text))::date AS stat_date,
    count(*) AS sessions,
    COALESCE(sum(correct_chars), (0)::bigint) AS correct_chars,
    COALESCE(sum(incorrect_chars), (0)::bigint) AS incorrect_chars,
    round(avg(wpm), 2) AS avg_wpm,
    round(avg(cpm), 2) AS avg_cpm,
    round(avg(accuracy), 2) AS avg_accuracy,
    COALESCE(sum(xp_earned), (0)::numeric) AS xp_earned
   FROM public.sessions s
  WHERE ((status = 'completed'::text) AND (user_id IS NOT NULL) AND (ended_at IS NOT NULL))
  GROUP BY user_id, (((ended_at AT TIME ZONE 'UTC'::text))::date);


