CREATE FUNCTION public.fn_leaderboard(p_metric text DEFAULT 'xp'::text, p_period text DEFAULT 'all'::text, p_limit integer DEFAULT 100) RETURNS TABLE(user_id uuid, display_name text, value numeric, rank bigint)
    LANGUAGE plpgsql STABLE
    AS $$
DECLARE
    v_start TIMESTAMPTZ;
BEGIN
    p_metric := lower(p_metric);
    p_period := lower(p_period);

    IF p_metric NOT IN ('wpm', 'cpm', 'accuracy', 'xp') THEN
        RAISE EXCEPTION 'Unsupported metric: %', p_metric;
    END IF;

    IF p_period NOT IN ('day', 'week', 'month', 'all') THEN
        RAISE EXCEPTION 'Unsupported period: %', p_period;
    END IF;

    IF p_limit IS NULL OR p_limit < 1 THEN
        p_limit := 100;
    END IF;

    IF p_limit > 500 THEN
        p_limit := 500;
    END IF;

    IF p_period = 'day' THEN
        v_start := date_trunc('day', now());
    ELSIF p_period = 'week' THEN
        v_start := date_trunc('week', now());
    ELSIF p_period = 'month' THEN
        v_start := date_trunc('month', now());
    ELSE
        v_start := NULL;
    END IF;

    RETURN QUERY
    WITH base AS (
        SELECT
            s.user_id,
            COALESCE(u.display_name, split_part(u.email::text, '@', 1)) AS display_name,
            s.wpm,
            s.cpm,
            s.accuracy,
            s.xp_earned
        FROM public.sessions s
        JOIN public.users u ON u.id = s.user_id
        WHERE s.status = 'completed'
          AND s.user_id IS NOT NULL
          AND (v_start IS NULL OR s.ended_at >= v_start)
    ),
    agg AS (
        SELECT
            user_id,
            display_name,
            CASE p_metric
                WHEN 'xp' THEN SUM(xp_earned)::NUMERIC
                WHEN 'wpm' THEN MAX(wpm)::NUMERIC
                WHEN 'cpm' THEN MAX(cpm)::NUMERIC
                WHEN 'accuracy' THEN MAX(accuracy)::NUMERIC
            END AS value
        FROM base
        GROUP BY user_id, display_name
    )
    SELECT
        agg.user_id,
        agg.display_name,
        agg.value,
        RANK() OVER (ORDER BY agg.value DESC) AS rank
    FROM agg
    ORDER BY 4, 3 DESC
    LIMIT p_limit;
END;
$$;


