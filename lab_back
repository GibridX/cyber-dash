--

CREATE VIEW public.v_character_difficulty AS
 SELECT user_id,
    "char",
    attempts,
    correct,
    incorrect,
        CASE
            WHEN (attempts > 0) THEN round(((100.0 * (incorrect)::numeric) / (attempts)::numeric), 2)
            ELSE (0)::numeric
        END AS error_rate,
    avg_delay_ms,
    last_seen_at
   FROM public.character_stats cs
  WHERE (attempts >= 5);


